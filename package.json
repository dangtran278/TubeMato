{
  "name": "tubemato",
  "version": "0.2.0",
  "description": "Lightweight Pomodoro timer with YouTube integration and productivity tracking",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "vite",
    "electron:build": "npm run build && electron-builder --win nsis --x64",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-extension-icons": "node scripts/generate-extension-icons.js",
    "bootstrap:icons": "npm run generate-icons && npm run generate-extension-icons"
  },
  "dependencies": {
    "electron-auto-launch": "^5.0.6",
    "electron-store": "^8.2.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^20.12.0",
    "@types/uuid": "^9.0.8",
    "@types/youtube": "^0.1.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tubemato.app",
    "productName": "TubeMato",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icons/icon256.png",
    "asarUnpack": [
      "assets/icons/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon256.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "tubemato-youtube-bridge",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}