{
  "name": "TubeMato",
  "version": "0.2.0",
  "description": "Lightweight Pomodoro timer with YouTube integration and productivity tracking",
  "author": {
    "name": "Dantern"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "vite",
    "clean:package-artifacts": "node scripts/clean-package-output.js",
    "electron:build": "npm run build && node scripts/build-win-icon.js && electron-builder --win nsis --x64",
    "electron:build:win-all": "npm run build && node scripts/build-win-icon.js && electron-builder --win nsis --x64 --ia32 --arm64",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-extension-icons": "node scripts/generate-extension-icons.js",
    "bootstrap:icons": "npm run generate-icons && npm run generate-extension-icons"
  },
  "dependencies": {
    "electron-auto-launch": "^5.0.6",
    "electron-store": "^8.2.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^20.12.0",
    "@types/uuid": "^9.0.8",
    "@types/youtube": "^0.1.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tubemato.desktop",
    "productName": "TubeMato",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icons/app.ico",
    "asarUnpack": [
      "assets/icons/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "assets/icons/app.ico"
    },
    "afterPack": "scripts/afterPack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false
    },
    "files": [
      "dist/**/*",
      "!dist/win-unpacked{,/**}",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/builder-effective-config.yaml",
      "!dist/builder-debug.yml",
      "dist-electron/**/*",
      "assets/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "tubemato-icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extension",
        "to": "tubemato-youtube-bridge",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}